// ========== 公众号配置 ==========
const MP_CONFIG_FILE = path.join(__dirname, "wechat_mp_config.json");
const QR_TEMPLATE_FILE = path.join(__dirname, "qr_template.png");
// 公众号配置按工作区隔离: { tenantId: { appId, appSecret, token, encodingAESKey, menuKey, enabled } }
let mpConfigs = {};
let mpAccessTokens = {}; // { tenantId: { token, expiresAt } }

function getMpConfig(tenantId) {
  if (!mpConfigs[tenantId]) {
    mpConfigs[tenantId] = { appId: "", appSecret: "", token: "", encodingAESKey: "", menuKey: "BIND_QR", enabled: false };
  }
  return mpConfigs[tenantId];
}

function loadMpConfig() {
  if (fs.existsSync(MP_CONFIG_FILE)) {
    try {
      const content = fs.readFileSync(MP_CONFIG_FILE, "utf-8").trim();
      if (content) {
        const data = JSON.parse(content);
        // 兼容旧格式（全局配置）
        if (data.appId !== undefined) {
          mpConfigs = { "default": data };
        } else {
          mpConfigs = data;
        }
      }
    } catch (e) {}
  }
}
function saveMpConfig() {
  try { fs.writeFileSync(MP_CONFIG_FILE, JSON.stringify(mpConfigs, null, 2), "utf-8"); } catch (e) {}
}

